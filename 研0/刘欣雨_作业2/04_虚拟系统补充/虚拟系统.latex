\subsection*{4.2 Shell编程}

\subsubsection*{4.2.1 基本格式}
Shell脚本的文件名后缀通常是 .sh。

第一行固定格式：\texttt{\#!/bin/bash}

\subsubsection*{4.2.2 打印输出命令 \texttt{echo}}
\begin{lstlisting}
# 在普通用户neon的家目录中创建shell目录
mkdir /home/neon/shell

# 在shell目录中创建firstshell.sh并编辑
vi /home/neon/shell/firstshell.sh

# 在firstshell.sh中写入代码
#!/bin/bash
echo "HELLO WORLD"

# 检查firstshell.sh是否具有可执行权限
ll /home/neon/shell

# 为firstshell.sh增加可执行权限
chmod u+x /home/neon/shell/firstshell.sh

# 执行firstshell.sh脚本
cd /home/neon/shell
./firstshell.sh
\end{lstlisting}

\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell1.png}
\caption{执行第一个Shell脚本}
\end{figure}

\subsubsection*{4.2.3 Shell中的变量}
Linux Shell中的变量分为系统变量和用户自定义变量。\\
系统变量如 \texttt{\$HOME}、\texttt{\$PWD}、\texttt{\$USER}、\texttt{\$SHELL}。\\
自定义变量基本语法：\texttt{变量名称=值}。

变量不需要声明，初始化不需要指定类型。\\
变量命名规则：
\begin{enumerate}
\item 只能使用数字、字母和下划线，且不能以数字开头。
\item 变量名区分大小写。
\item 中间不能有空格，可以使用下划线，不能使用标点符号。
\end{enumerate}

\begin{lstlisting}
#!/bin/bash
my_name="liuxinyu"
str='this is a string'
my_major="Computer Technology"
str1=$str

echo "my name is ${my_name}"
echo "my height is ${my_he}"
\end{lstlisting}

\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell3.png}
\caption{变量使用示例}
\end{figure}

\subsubsection*{4.2.4 Shell基本运算符（+ - * / \%）}
原生bash不支持简单的数学运算，expr是一款表达式计算工具，使用它能完成表达式的求值操作。

\begin{lstlisting}
#!/bin/bash
val1=`expr 2 + 2`
echo "2 + 2 = ${val1}"

val2=`expr 2 - 2`
echo "2 - 2 = ${val2}"

val3=`expr 2 / 2`
echo "2 / 2 = ${val3}"

val4=`expr 2 \* 2`
echo "2 * 2 = ${val4}"

val5=`expr 2 % 2`
echo "2 % 2 = ${val5}"
\end{lstlisting}

\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell4.png}
\caption{expr运算示例}
\end{figure}

注意：
\begin{itemize}
\item 表达式和运算符之间要有空格，例如 2+2 是不对的，必须写成 2 + 2。
\item 完整的表达式要被反引号（`）包含，该字符在Esc键下方。
\end{itemize}

\subsubsection*{4.2.5 Shell传递参数}
\begin{lstlisting}
#!/bin/bash
echo "first num：$1"
echo "second num：$2"
\end{lstlisting}
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell5.png}
\caption{传递参数示例}
\end{figure}

\subsubsection*{4.2.6 传递的参数赋值给自定义变量}
\begin{lstlisting}
#!/bin/bash
a=$1
b=$2
result=`expr $a \* $b`
echo "${a} * ${b} = ${result}"
\end{lstlisting}
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell6.png}
\caption{参数赋值运算}
\end{figure}
\subsubsection*{4.2.7 流程控制}
单分支if：
\begin{lstlisting}
if [ 条件判断式 ]
then
    代码
fi
\end{lstlisting}

双分支if-else：
\begin{lstlisting}
if [ 条件判断式 ]
then
    代码
else
    代码
fi
\end{lstlisting}

多分支if-elif-else：
\begin{lstlisting}
if [ 条件判断式 ]
then
    代码
elif [ 条件判断式 ]
then
    代码
else
    代码
fi
\end{lstlisting}

\subsubsection*{4.2.7 逻辑运算符}
\begin{table}[htbp]
\centering
\caption{常用逻辑运算符}
\label{tab:logic}
\begin{tabular}{c|c}
\toprule
\textbf{符号} & \textbf{含义} \\
\midrule
\texttt{-lt} & 小于 \\
\texttt{-le} & 小于等于 \\
\texttt{-eq} & 等于 \\
\texttt{-gt} & 大于 \\
\texttt{-ge} & 大于等于 \\
\texttt{-ne} & 不等于 \\
\bottomrule
\end{tabular}
\end{table}

示例1：判断两个整数是否相等
\begin{lstlisting}
#!/bin/bash
a=$1
b=$2
if [ $a -eq $b ]; then
    echo "${a} 等于 ${b}"
else
    echo "${a} 不等于 ${b}"
fi
\end{lstlisting}
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell7.png}
\caption{判断相等}
\end{figure}

示例2：比较两个整数的大小关系
\begin{lstlisting}
#!/bin/bash
a=$1
b=$2
if [ $a -gt $b ]; then
    echo "${a} 大于 ${b}"
elif [ $a -lt $b ]; then
    echo "${a} 小于 ${b}"
else
    echo "${a} 等于 ${b}"
fi
\end{lstlisting}
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell8.png}
\caption{比较大小}
\end{figure}

示例3：成绩等级判断
\begin{lstlisting}
#!/bin/bash
grade=$1
if [ $grade -eq 100 ]; then
    echo "congratulation!!!!"
elif [ $grade -ge 90 ]; then
    echo "your grade is A"
elif [ $grade -ge 80 ]; then
    echo "your grade is B"
elif [ $grade -ge 70 ]; then
    echo "your grade is C"
elif [ $grade -ge 60 ]; then
    echo "your grade is D"
else
    echo "your grade is E"
fi
\end{lstlisting}
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{shell9.png}
\caption{成绩等级判断}
\end{figure}

